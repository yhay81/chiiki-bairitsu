{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiiki-bairitsu",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chiiki-bairitsu.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["31 22 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chiiki-bairitsu",
      "database_id": "3f8c49b4-e2a6-45f0-b749-fb479d7703d9",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
